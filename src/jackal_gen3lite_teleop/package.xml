<?xml version="1.0"?>
<package format="3">
  <name>jackal_gen3lite_teleop</name>
  <version>0.1.0</version>
  <description>Keyboard teleop (base, MoveIt Servo arm, gripper) for Jackal J100 + Kinova Gen3 lite</description>
  <maintainer email="user@example.com">haidar</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>control_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>clearpath_config</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
